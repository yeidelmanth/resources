{
  "name": "TH Resources editor",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "npm ci",
  "postAttachCommand": "HOST=0.0.0.0 ADMIN_PASSWORD=${ADMIN_PASSWORD:-codespace} npm run admin",
  "forwardPorts": [4000],
  "portsAttributes": { "4000": { "label": "Editor", "onAutoForward": "openPreview" } }
}
